# Optional. Copy to .env.local and fill in what you want to enable.

# Address used by the mailto: fallback of the contact form.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional form endpoint (e.g. https://formspree.io/f/xxxxxxx). When set, the form
# POSTs JSON there and only reports success if the endpoint answers with HTTP 2xx.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional social links (full https:// URLs). Empty values are not rendered.
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
